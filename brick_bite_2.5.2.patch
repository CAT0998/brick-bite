+// Brick bite: on alternating layers the first (outer) wall is printed half as wide.
+// Its centreline moves to keep the outer face flush, so the whole inner wall block
+// shifts sideways by half a line width - no polygon offset needed.
+static void apply_brick_outer_width(PerimeterGenerator &pg)
+{
+    if (pg.config->brick_wall_mode.value == BrickWallMode::bwmNone)
+        return;
+    // Spiral vase prints one continuous outer wall; a per-layer width change breaks it.
+    if (pg.print_config->spiral_mode.value)
+        return;
+
+    const bool  odd    = (pg.layer_id % 2) == 1;
+    const float factor = (pg.config->brick_wall_mode.value == BrickWallMode::bwmHalf)
+                             ? (odd ? 0.5f : 1.0f)
+                             : (odd ? 0.5f : 1.5f);
+
+    float       w = pg.ext_perimeter_flow.width() * factor;
+    const float h = pg.ext_perimeter_flow.height();
+    // Guard: a too narrow width produces a negative flow, a too wide one exceeds what
+    // the nozzle can push. Keep the result inside what the machine can actually extrude.
+    w = std::max(w, h * 1.25f);
+    float max_nozzle = 0.f;
+    for (double d : pg.print_config->nozzle_diameter.values)
+        max_nozzle = std::max(max_nozzle, float(d));
+    if (max_nozzle > 0.f)
+        w = std::min(w, max_nozzle * 2.4f);
+    pg.ext_perimeter_flow = pg.ext_perimeter_flow.with_width(w);
+}
