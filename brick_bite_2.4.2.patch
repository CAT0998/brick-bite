+// Brick bite: on alternating layers the first (outer) wall is printed half as wide.
+// Its centreline moves to keep the outer face flush, so the whole inner wall block
+// shifts sideways by half a line width - no polygon offset needed.
+static void apply_brick_outer_width(PerimeterGenerator &pg)
+{
+    if (pg.config->brick_wall_mode.value == BrickWallMode::bwmNone)
+        return;
+    const bool odd = (pg.layer_id % 2) == 1;
+    float factor;
+    if (pg.config->brick_wall_mode.value == BrickWallMode::bwmHalf)
+        factor = odd ? 0.5f : 1.0f;
+    else
+        factor = odd ? 0.5f : 1.5f;
+    pg.ext_perimeter_flow = pg.ext_perimeter_flow.with_width(pg.ext_perimeter_flow.width() * factor);
+}
+
 void PerimeterGenerator::process_classic()
 {
+    apply_brick_outer_width(*this);
     group_region_by_fuzzify(*this);
 
     // other perimeters
@@ -2092,6 +2109,7 @@
 // "A framework for adaptive width control of dense contour-parallel toolpaths in fused deposition modeling"
